# JobHubNG Environment Configuration

# Database
JOBHUB_DB_URL=jdbc:postgresql://postgres:5432/jobhub
JOBHUB_DB_USER=jobhub
JOBHUB_DB_PASSWORD=jobhub

# Spring Security JWT
JOBHUB_JWT_SECRET=jobhub-dev-secret-change-me-please-32-bytes

# Frontend CORS
JOBHUB_WEB_ORIGIN=http://localhost:3000

# Spring AI / OpenAI (for agent enrichment)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Server Ports
SERVER_PORT=8080
