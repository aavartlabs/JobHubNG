# JobHubNG Environment Configuration

# Database
JOBHUB_DB_URL=jdbc:postgresql://postgres:5432/jobhub
JOBHUB_DB_USER=jobhub
JOBHUB_DB_PASSWORD=jobhub

# Spring Security JWT
JOBHUB_JWT_SECRET=jobhub-dev-secret-change-me-please-32-bytes

# Frontend CORS
JOBHUB_WEB_ORIGIN=https://jobhubs.aavartlabs.com

# AI / Ollama (for agent enrichment)
# Ollama is running on your remote host at http://192.168.2.106:11434
OLLAMA_BASE_URL=http://192.168.2.106:11434
OLLAMA_MODEL=ministral-3:14b

# Server Ports
SERVER_PORT=8080

# Frontend API base (what the browser uses to reach the API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Cloudflare Tunnel (for production exposure)
# Get this from your Cloudflare Zero Trust dashboard
# CLOUDFLARE_TUNNEL_TOKEN=eyJhI...your-token-here
