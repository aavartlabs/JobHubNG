PORT=3200
# Own SQLite file, separate from the Flask app's jobhub.db.
AUTH_DB_PATH=./auth.db
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-secret
# Must match how this service is actually reached -- an https:// value here
# (or NODE_ENV=production) makes Better Auth mark the session cookie
# __Secure-, changing its exact name. See README.
BETTER_AUTH_URL=http://localhost:3200
# Comma-separated origins allowed for state-changing (cookie-bearing) POST
# requests -- see README's "Origin header" note. Whatever Origin a caller
# (e.g. the Flask app) sends on those requests must be listed here.
TRUSTED_ORIGINS=http://localhost:3200
WHATSAPP_GATEWAY_URL=http://localhost:3100
WHATSAPP_GATEWAY_API_KEY=change-me-to-a-random-secret
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.example
