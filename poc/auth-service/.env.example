# poc/auth-service/.env -- copy to .env and fill in real values.
#
# Two very different environments read this file, and several defaults below are
# correct for only ONE of them:
#   (a) plain local dev  -- `npm start` on your own machine, everything on localhost;
#   (b) the pi09 deployment -- this service runs as the `auth-service` container in
#       poc/docker-compose.yml, reachable only from the `web` (Flask) container over
#       the jobhub Docker network, with the public origin https://jobhubs.aavartlabs.com.
# Each entry says which value belongs where. Values that poc/docker-compose.yml already
# overrides for (b) are marked "compose overrides" -- you don't have to get those right
# in a deployed .env, but everything else you do.

PORT=3200

# Own SQLite file, separate from the Flask app's jobhub.db.
# (a) ./auth.db, relative to this directory.
# (b) compose overrides this to /app/data/auth.db so it lands on the mounted
#     ./auth-service/data volume and survives a container recreate.
AUTH_DB_PATH=./auth.db

# REQUIRED. `openssl rand -base64 32`. Not optional in the deployed container: with
# NODE_ENV=production (set in the Dockerfile) Better Auth refuses to start if this is
# unset, and changing it later invalidates every existing session.
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# REQUIRED -- the PUBLIC origin a browser reaches this service's /auth/* paths at.
# Because Flask reverse-proxies /auth/* on its own origin (auth_proxy.py), that is the
# Flask app's public origin, NOT this service's internal address.
# (a) http://localhost:8100
# (b) https://jobhubs.aavartlabs.com  <-- MUST be the real https:// origin in production.
#     Leaving an http:// value here in production is not a hard failure but is wrong:
#     Better Auth derives the session cookie's Secure attribute (and the __Secure- name
#     prefix) from this URL's scheme, so an http:// value silently issues session
#     cookies without Secure over an https site.
# Also note: leaving this EMPTY breaks rate limiting (Better Auth derives the rate-limit
# base path from it), so always set it.
BETTER_AUTH_URL=http://localhost:8100

# Comma-separated origins allowed for state-changing (cookie-bearing) POST requests --
# see README's "Origin header" note. This is the origin of the CALLER (the browser, and
# Flask's own server-to-server sign-out call), i.e. the Flask app's public origin -- NOT
# this service's own address.
# (a) http://localhost:8100      (matches poc/.env.example's WEB_ORIGIN)
# (b) https://jobhubs.aavartlabs.com
# Keep this in sync with WEB_ORIGIN in poc/.env -- a mismatch makes /logout fail with
# 403 MISSING_OR_NULL_ORIGIN/INVALID_ORIGIN.
TRUSTED_ORIGINS=http://localhost:8100

# The existing whatsapp-sender gateway, used for mobile OTP delivery.
# (a) http://localhost:3100 -- the port whatsapp-sender publishes on the host.
# (b) compose overrides this to http://whatsapp:3100 (the sibling container's compose
#     service name). Inside a container, `localhost` is the container itself, so the
#     localhost default below would never reach the gateway.
WHATSAPP_GATEWAY_URL=http://localhost:3100
# Must match the same key in poc/whatsapp-sender/.env, or every phone OTP is rejected.
WHATSAPP_GATEWAY_API_KEY=change-me-to-a-random-secret

# Resend, for email OTP delivery. RESEND_FROM_EMAIL's domain must be verified in the
# Resend dashboard (SPF/DKIM DNS) first -- see README's one-time-setup section.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.example
