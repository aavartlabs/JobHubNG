# ---- EverJobs scraper (runs on pi05, in poc/scraper/) ----
EVER_JOBS_API_URL=http://localhost:3001
EVER_JOBS_API_KEY=
# Informational only -- the buckets actually scraped are set by DEFAULT_SITE_NAMES on the
# EverJobs server itself (pi05's systemd unit). Keep in sync so the dump log is accurate.
EVER_JOBS_SITE_NAMES=google,naukri,linkedin,indeed,glassdoor
REQUEST_TIMEOUT_SECONDS=600
SEARCH_TERMS=engineer,product manager,data analyst,data scientist,designer,marketing,sales,customer success,operations,finance,human resources,devops,quality assurance,content,recruiter
RESULTS_PER_TERM=50
DUMP_DIR=./dumps

# ---- Loader (runs on pi09, in poc/jobhub_poc/) ----
JOBHUB_SQLITE_PATH=./data/jobhub.db
# Serving-DB retention now lives in config/pipeline.ini [retention] serving_retention_days.

# ---- Web app (runs on pi09) ----
WEB_PORT=8100
WEB_SECRET_KEY=change-me-please-32-bytes-min

# ---- Auth (poc/auth-service/, a separate Better Auth companion service) ----
# Server-to-server address of auth-service, as reached from inside this app -- over
# container DNS in docker-compose (http://auth-service:3200), localhost in plain `mvnw`-
# style local dev. Port 3200 matches auth-service's own PORT default (src/server.js /
# auth-service/.env.example) -- keep these in sync if that default ever changes.
AUTH_SERVICE_URL=http://localhost:3200
# The origin THIS app is publicly reachable at (what a browser's Origin header will be on
# same-origin fetches through the /auth/* proxy). docker-compose.yml passes this straight
# through to auth-service as both its TRUSTED_ORIGINS and its BETTER_AUTH_URL (and refuses
# to start if it's unset), so this one variable is the single place the deployment's public
# origin is configured. Get it wrong and auth.py's /logout server-to-server sign-out call
# is rejected with 403 MISSING_OR_NULL_ORIGIN/INVALID_ORIGIN, and session cookies are
# issued without the Secure attribute over https -- see poc/auth-service/README.md.
# In production this is https://jobshub.aavartlabs.com, not the localhost default below.
WEB_ORIGIN=http://localhost:8100
# Former public hostnames, comma-separated, permanently redirected to the same path on
# WEB_ORIGIN (e.g. LEGACY_HOSTS=jobhubs.aavartlabs.com after the 2026-09 rename). The
# Cloudflare Tunnel must still route them to jobhub-web for the redirect to be reached.
LEGACY_HOSTS=

# ---- Bot protection: Cloudflare Turnstile (webapp/turnstile.py) ----
# Guards signup, login, email/WhatsApp code sends, the alert subscription form and the
# admin login. Sitekey + secret come from the Turnstile widget in the Cloudflare
# dashboard; the widget's hostname list must include WEB_ORIGIN's host.
TURNSTILE_SITEKEY=
CF_TURNSTILE_SECRET=
# Hostnames a solved token must come from. Defaults to WEB_ORIGIN's host; never list
# localhost here on a production deployment.
# TURNSTILE_HOSTNAMES=
# Local dev without a real widget: use Cloudflare's test pair
#   TURNSTILE_SITEKEY=1x00000000000000000000AA
#   CF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# and set TURNSTILE_ALLOW_TEST_KEYS=1. Never set that in production.
# TURNSTILE_ALLOW_TEST_KEYS=

# ---- Admin console (/admin, webapp/admin.py) ----
# Shared with auth-service (compose passes it through as ADMIN_API_KEY) for its internal
# user-management API. `openssl rand -base64 32`. Unset = admin user pages disabled.
AUTH_ADMIN_API_KEY=
# Admin login lockout: after ADMIN_MAX_FAILURES failures per IP or per username, lock for
# ADMIN_LOCKOUT_MINUTES, doubling each time, capped at ADMIN_LOCKOUT_MAX_MINUTES.
# ADMIN_MAX_FAILURES=5
# ADMIN_LOCKOUT_MINUTES=15
# ADMIN_LOCKOUT_MAX_MINUTES=1440
# Admin accounts are app_users rows: create or rotate one with
#   .venv/bin/python scripts/set_admin_password.py <username>

# ---- Alerts ----
# Email digests (alerts/senders.py) go through Resend: same account as auth-service's OTP
# emails; the From address must be on a Resend-verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=JobHub <noreply@alerts.example.com>
# "console" prints digests instead of sending (dry runs); "live" sends email + Telegram
# ("whatsapp" is the older name for live and still works). No restart needed:
# run_alerts.py reads this fresh on every invocation.
NOTIFIER_BACKEND=console
# Telegram: all of it goes through telegram-gateway/, the only holder of the bot token.
# Compose hands the gateway TELEGRAM_BOT_TOKEN, TELEGRAM_GATEWAY_API_KEY,
# TELEGRAM_WEBHOOK_SECRET and TELEGRAM_INTERNAL_API_KEY (openssl rand -hex 32 each), and
# auth-service TELEGRAM_BOT_USERNAME (without the @) + TELEGRAM_INTERNAL_API_KEY.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GATEWAY_URL=http://127.0.0.1:3300
TELEGRAM_GATEWAY_API_KEY=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INTERNAL_API_KEY=
# WhatsApp: only the admin fallback now (admin_notify.py).
WHATSAPP_GATEWAY_URL=http://localhost:3100
WHATSAPP_GATEWAY_API_KEY=change-me-to-a-random-secret
# Admin-only channel for ops alerts (backup / restore drill / cold export failed) and admin
# sign-in codes: Telegram when ADMIN_TELEGRAM_CHAT_ID is set (the bot's reply to /start
# shows it), else this WhatsApp number. Never a site user's chat or number.
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_ALERT_WHATSAPP=

# Resume features (routes_profile.py, ai/). Unset keys mean AI work stays queued ("AI offline").
# Which writing models: "ollama" (a local model on the LAN; resumes stay on JobsHub's
# machines) or "openrouter" (hosted, below). AI_PAUSED=1 makes no AI calls at all (tasks wait,
# matching is plain word matching). AI_READ_ALL_JOBS=1 reads every listed job after each
# pipeline load (otherwise a job is read when someone with a resume opens it).
AI_BACKEND=ollama
OLLAMA_URL=
OLLAMA_MODEL=gemma4:e2b
# Context window (tokens) asked for on each request; empty = the Ollama server's setting.
OLLAMA_NUM_CTX=
AI_PAUSED=
AI_READ_ALL_JOBS=
# Jev (TypeSafe) makes the judgments -- job reading, matching (ai/typesafe.py) -- when set.
TYPESAFE_API_KEY=
# General models through OpenRouter (ai/openrouter.py), tried in order. AI_MODELS_WRITE carries
# resume data: only models that don't train on it ("-contributor" tiers are refused).
# AI_MODELS_JOBS reads public job postings. When the consent wording changes, set
# RESUME_CONSENT_SINCE (ISO, UTC) and existing resume holders are asked to agree again.
OPENROUTER_API_KEY=
AI_MODELS_WRITE=openai/gpt-6-luna-pro,deepseek/deepseek-v4-flash
# Bake-off 2026-09-25 (54 postings): Muse Spark contributor on Meta's own API ("direct:meta")
# read jobs best -- 0 failures, 6.3 s, 5.5% invented skills dropped (Luna Pro 9%, DeepSeek
# 10.5% and 4 bad answers). It trains on prompts: public job text only, never resume data.
AI_MODELS_JOBS=direct:meta,openai/gpt-6-luna-pro,deepseek/deepseek-v4-flash
OPENROUTER_ZDR=
RESUME_CONSENT_SINCE=
# AI tasks run at once (ai/worker.py). Unset: 1 for ollama (one GPU), 6 for hosted models.
AI_WORKERS=
# Last resort for public job text only, when OpenRouter is down (ai/direct.py).
DIRECT_JOBS_PROVIDERS=deepseek
DEEPSEEK_API_KEY=
# Meta's own API for "direct:meta" (public job text only): minimal reasoning answers in ~2 s.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Meta's model list depends on where the request comes from: from the Hostinger server only
# 1.2 is offered (1.3 answers model_not_found). Measured there on 54 postings: 1.2 contributor
# 0 failures, p50 4.3 s, 4.9% invented skills -- the best job reader.
META_MODEL=muse-spark-1.2-contributor
META_JSON=schema
META_REASONING_EFFORT=minimal
# Encrypts every stored resume. Generate once:
#   .venv/bin/python -c "from jobhub_poc.crypto import new_key; print(new_key())"
# and keep a copy offline -- without it, stored resumes (and their backups) can't be read.
# Unset = resume upload is switched off.
RESUME_ENCRYPTION_KEY=
