# ---- EverJobs scraper (runs on pi05, in poc/scraper/) ----
EVER_JOBS_API_URL=http://localhost:3001
EVER_JOBS_API_KEY=
# Informational only -- the buckets actually scraped are set by DEFAULT_SITE_NAMES on the
# EverJobs server itself (pi05's systemd unit). Keep in sync so the dump log is accurate.
EVER_JOBS_SITE_NAMES=google,naukri,linkedin,indeed,glassdoor
REQUEST_TIMEOUT_SECONDS=600
SEARCH_TERMS=engineer,product manager,data analyst,data scientist,designer,marketing,sales,customer success,operations,finance,human resources,devops,quality assurance,content,recruiter
RESULTS_PER_TERM=50
DUMP_DIR=./dumps

# ---- Loader (runs on pi09, in poc/jobhub_poc/) ----
JOBHUB_SQLITE_PATH=./data/jobhub.db
# Serving-DB retention now lives in config/pipeline.ini [retention] serving_retention_days.

# ---- Web app (runs on pi09) ----
WEB_PORT=8100
WEB_SECRET_KEY=change-me-please-32-bytes-min

# ---- Auth (poc/auth-service/, a separate Better Auth companion service) ----
# Server-to-server address of auth-service, as reached from inside this app -- over
# container DNS in docker-compose (http://auth-service:3200), localhost in plain `mvnw`-
# style local dev. Port 3200 matches auth-service's own PORT default (src/server.js /
# auth-service/.env.example) -- keep these in sync if that default ever changes.
AUTH_SERVICE_URL=http://localhost:3200
# The origin THIS app is publicly reachable at (what a browser's Origin header will be on
# same-origin fetches through the /auth/* proxy). docker-compose.yml passes this straight
# through to auth-service as both its TRUSTED_ORIGINS and its BETTER_AUTH_URL (and refuses
# to start if it's unset), so this one variable is the single place the deployment's public
# origin is configured. Get it wrong and auth.py's /logout server-to-server sign-out call
# is rejected with 403 MISSING_OR_NULL_ORIGIN/INVALID_ORIGIN, and session cookies are
# issued without the Secure attribute over https -- see poc/auth-service/README.md.
# In production this is https://jobhubs.aavartlabs.com, not the localhost default below.
WEB_ORIGIN=http://localhost:8100

# ---- Bot protection: Cloudflare Turnstile (webapp/turnstile.py) ----
# Guards signup, login, email/WhatsApp code sends, the alert subscription form and the
# admin login. Sitekey + secret come from the Turnstile widget in the Cloudflare
# dashboard; the widget's hostname list must include WEB_ORIGIN's host.
TURNSTILE_SITEKEY=
CF_TURNSTILE_SECRET=
# Hostnames a solved token must come from. Defaults to WEB_ORIGIN's host; never list
# localhost here on a production deployment.
# TURNSTILE_HOSTNAMES=
# Local dev without a real widget: use Cloudflare's test pair
#   TURNSTILE_SITEKEY=1x00000000000000000000AA
#   CF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# and set TURNSTILE_ALLOW_TEST_KEYS=1. Never set that in production.
# TURNSTILE_ALLOW_TEST_KEYS=

# ---- Admin console (/admin, webapp/admin.py) ----
# Shared with auth-service (compose passes it through as ADMIN_API_KEY) for its internal
# user-management API. `openssl rand -base64 32`. Unset = admin user pages disabled.
AUTH_ADMIN_API_KEY=
# Admin login lockout: after ADMIN_MAX_FAILURES failures per IP or per username, lock for
# ADMIN_LOCKOUT_MINUTES, doubling each time, capped at ADMIN_LOCKOUT_MAX_MINUTES.
# ADMIN_MAX_FAILURES=5
# ADMIN_LOCKOUT_MINUTES=15
# ADMIN_LOCKOUT_MAX_MINUTES=1440
# Admin accounts are app_users rows: create or rotate one with
#   .venv/bin/python scripts/set_admin_password.py <username>

# ---- Alerts ----
# Email digests (alerts/senders.py) go through Resend: same account as auth-service's OTP
# emails; the From address must be on a Resend-verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=JobHub <noreply@alerts.example.com>
# "console" prints digests instead of sending (dry runs); "live" sends email + WhatsApp
# ("whatsapp" is the older name for live and still works). Leave as "console" until the
# whatsapp-sender/ service has been paired (see its README --
# the pairing step is a manual QR scan and can't be scripted). Once paired, switch to
# "whatsapp" -- no restart needed, run_alerts.py reads this fresh on every invocation.
NOTIFIER_BACKEND=console
WHATSAPP_GATEWAY_URL=http://localhost:3100
WHATSAPP_GATEWAY_API_KEY=change-me-to-a-random-secret
