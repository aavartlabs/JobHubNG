# Only for running the gateway outside Docker. Under docker compose every value below
# comes from poc/.env instead (see docker-compose.yml's telegram service).
PORT=3300
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Callers of POST /send (Flask, the alert CLIs) send this as x-api-key.
TELEGRAM_GATEWAY_API_KEY=
# Telegram sends this back on every webhook call; anything else is refused.
TELEGRAM_WEBHOOK_SECRET=
# Public URL Telegram posts updates to (Flask forwards /telegram/webhook here).
# Unset = the gateway only sends, it never receives.
TELEGRAM_WEBHOOK_URL=
# auth-service, for account linking (/internal/telegram/start).
AUTH_SERVICE_URL=http://localhost:3200
TELEGRAM_INTERNAL_API_KEY=
# Public site origin, for links in the bot's help text.
SITE_URL=http://localhost:8100
