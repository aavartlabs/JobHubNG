PORT=3100
WHATSAPP_GATEWAY_API_KEY=change-me-to-a-random-secret
AUTH_DIR=./auth_info
LOG_LEVEL=warn
# How long /send waits for WhatsApp's server to acknowledge a message before
# reporting it as undelivered. Keep below the caller's HTTP timeout (the
# Python WhatsAppNotifier defaults to 55s) so a real timeout here always
# reaches the caller as a clean error. Raised from an original 12s to 45s on
# 2026-09-22 after a recipient with multiple linked WhatsApp devices needed
# real time for per-device session renegotiation post-repair -- NOTE this
# did not actually resolve that specific case (it still timed out with no
# SERVER_ACK even at 45s), so treat this as headroom for slower-but-working
# multi-device deliveries, not a proven fix for a stuck one.
ACK_TIMEOUT_MS=45000
