# Installed on pi09 as ~/.config/systemd/user/jobshub-alert-admin@.service.
# Started by OnFailure= in the backup, restore-drill and cold-export units; %i is the failed unit.
[Unit]
Description=Tell the JobsHub admin (Telegram, else WhatsApp) that %i failed

[Service]
Type=oneshot
WorkingDirectory=%h/jobhub-poc
ExecStart=%h/jobhub-poc/.venv/bin/python -m jobhub_poc.ops.alert_admin %i
StandardOutput=append:%h/jobhub-poc/backup.log
StandardError=append:%h/jobhub-poc/backup.log
